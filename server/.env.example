# --- Core ---
NODE_ENV=development
PORT=4000
# Leave MONGO_URI empty in development to use an embedded MongoDB (data persisted in ./.mongo-data)
MONGO_URI=
JWT_SECRET=change-me-to-a-long-random-string
# 32-byte key (64 hex chars) used to encrypt bank / KYC fields. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
FIELD_ENCRYPTION_KEY=
# Public URL of the Next.js client (used in emails, share links, CORS, cache revalidation)
CLIENT_URL=http://localhost:3000
# Shared secret the API uses to tell the client to revalidate cached public pages
REVALIDATE_SECRET=change-me-too
# Root domain for realtor sites: {realtor}.{firm}.ROOT_DOMAIN. Empty = path-based URLs (CLIENT_URL/s/{firm}/{realtor})
ROOT_DOMAIN=
# Short-link base, e.g. https://rstk.ng. Empty = CLIENT_URL/l
SHORT_LINK_BASE=

# --- Optional infrastructure ---
# Redis for BullMQ job queues. Empty = jobs run in-process
REDIS_URL=
# SMTP for email. Empty = emails are logged to the console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="RealtorStack <no-reply@realtorstack.com>"
# Media storage: local (./uploads served at /media) or s3
STORAGE_DRIVER=local
MEDIA_BASE_URL=

# --- Seed / platform ---
SUPERADMIN_EMAIL=ops@markv.ng
SUPERADMIN_PASSWORD=ChangeMe123!
