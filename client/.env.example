# Express API (server folder). Used server-side and for /api + /media rewrites.
API_URL=http://localhost:4000
# Public URL of this Next.js app
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Root domain for realtor sites ({realtor}.{firm}.ROOT). Empty = path-based /s/{firm}/{realtor}
NEXT_PUBLIC_ROOT_DOMAIN=
# Host serving short links (e.g. rstk.ng). Empty = /l/{code}/{estate} on this app
SHORT_DOMAIN=
# Must match REVALIDATE_SECRET in server/.env
REVALIDATE_SECRET=dev-revalidate-secret
